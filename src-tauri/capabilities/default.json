{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "http:default"
  ],
  "scope": {
    "http": [
      {
        "url": "http://**",
        "allow": true
      },
      {
        "url": "https://**",
        "allow": true
      }
    ]
  }
}
