{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*" },
        { "url": "http://localhost:*/*" },
        { "url": "https://api.openai.com/*" },
        { "url": "https://api.typesafe.ai/*" },
        { "url": "https://auth.openai.com/*" },
        { "url": "https://chatgpt.com/*" }
      ]
    }
  ]
}
